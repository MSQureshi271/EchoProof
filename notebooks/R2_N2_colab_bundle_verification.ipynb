        "    test_module_spec.loader.exec_module(module)\n",
        "\n",
        "    suite = loader.loadTestsFromModule(module)\n",
        "\n",
        "    test_count = suite.countTestCases()\n",
        "    assert test_count > 0, f\"No tests discovered in {name}\"\n",
        "\n",
        "    output = io.StringIO()\n",
        "    runner = unittest.TextTestRunner(\n",
        "        verbosity=2,\n",
        "        stream=output\n",
        "    )\n",
        "    res = runner.run(suite)\n",
        "\n",
        "    run_count = res.testsRun\n",
        "    fail_count = len(res.failures)\n",
        "    err_count = len(res.errors)\n",
        "    pass_count = run_count - fail_count - err_count\n",
        "\n",
        "    total_run += run_count\n",
        "    total_failed += fail_count\n",
        "    total_errors += err_count\n",
        "\n",
        "    suite_status = (\n",
        "        \"PASS\" if fail_count == 0 and err_count == 0 else \"FAIL\"\n",
        "    )\n",
        "\n",
        "    runner_output = output.getvalue()\n",
        "\n",
        "    suite_summary.append({\n",
        "        \"suite\": name,\n",
        "        \"path\": rel_path,\n",
        "        \"discovered\": test_count,\n",
        "        \"run\": run_count,\n",
        "        \"passed\": pass_count,\n",
        "        \"failures\": fail_count,\n",
        "        \"errors\": err_count,\n",
        "        \"status\": suite_status,\n",
        "        \"output\": runner_output,\n",
        "    })\n",
        "\n",
        "    print(f\"\\n{'='*70}\")\n",
        "    print(f\"{name}: {suite_status}\")\n",
        "    print(runner_output)\n",
        "\n",
        "print(\"\\n\" + \"=\"*70)\n",
        "print(f\"TOTAL: run={total_run}, passed={total_run-total_failed-total_errors}, \"\n",
        "      f\"failures={total_failed}, errors={total_errors}\")\n",
        "\n",
        "STAGE_RESULTS[\"Stage K (Regression Suite)\"] = {\n",
        "    \"status\": \"PASS\" if total_failed == 0 and total_errors == 0 else \"FAIL\",\n",
        "    \"details\": f\"{total_run} tests run, {total_failed} failures, {total_errors} errors\"\n",
        "}\n"
      ]
    },
