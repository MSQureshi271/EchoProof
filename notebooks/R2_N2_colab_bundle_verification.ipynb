      "source": [
        "ORIG_MODEL_DIR = ROOT / \"runs/r2/r2_m1_20261106T140611Z/model\"\n",
        "ORIG_EVIDENCE_PATH = ROOT / \"runs/r2/r2_m1_20261106T140611Z/evidence.json\"\n",
