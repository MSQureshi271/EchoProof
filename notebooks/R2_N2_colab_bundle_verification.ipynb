assert test_path.is_file(), f\"Test suite file not found: {test_path}\"\n","\n","    test_module_spec = importlib.util.spec_from_file_location(name, test_path)\n","    assert test_module_spec is not None and test_module_spec.loader is not None\n","\n","    module = importlib.util.module_from_spec(test_module_spec)\n","    test_module_spec.loader.exec_module(module)\n","\n","    suite = loader.loadTestsFromModule(module)\n","\n","    test_count = suite.countTestCases()\n","    assert test_count > 0, f\"No tests discovered in {name}\"\n","\n","    output = io.StringIO()\n","    runner = unittest.TextTestRunner(\n","        verbosity=2,\n","        stream=output\n","    )\n","    res = runner.run(suite)\n","\n","    run_count = res.testsRun\n","    fail_count = len(res.failures)\n","    err_count = len(res.errors)\n","    pass_count = run_count - fail_count - err_count\n","\n","    total_run += run_count\n","    total_failed += fail_count\n","    total_errors += err_count\n","\n","    suite_status = (\n","        \"PASS\" if fail_count == 0 and err_count == 0 else \"FAIL\"\n","    )\n","\n","    runner_output = output.getvalue()\n","\n","    suite_summary.append({\n","        \"suite\": name,\n","        \"path\": rel_path,\n","        \"discovered\": test_count,\n","        \"run\": run_count,\n","        \"passed\": pass_count,\n","        \"failures\": fail_count,\n","        \"errors\": err_count,\n","        \"status\": suite_status,\n","        \"output\": runner_output,\n","    })\n","\n","    print(f\"\\n{'='*70}\")\n","    print(f\"{name}: {suite_status}\")\n","    print(runner_output)\n","\n","print(\"\\n\" + \"=\"*70)\n","print(f\"TOTAL: run={total_run}, passed={total_run-total_failed-total_errors}, \"\n","      f\"failures={total_failed}, errors={total_errors}\")\n","\n","STAGE_RESULTS[\"Stage K (Regression Suite)\"] = {\n","    \"status\": \"PASS\" if total_failed == 0 and total_errors == 0 else \"FAIL\",\n","    \"details\": f\"{total_run} tests run, {total_failed} failures, {total_errors} errors\"\n","}\n"]},{"cell_type":"markdown","id":"n2_000024","metadata":{"id":"n2_000024"},"source":["## Stage L — Verification Summary Table & Structured Evidence Export\n","\n","This stage compiles the final verification evidence table strictly from dynamically recorded results across Stages A–K (no hardcoded status values) and exports the structured evidence artifact to `reports/r2/r2_n2_colab_bundle_verification_report.json`."]},{"cell_type":"code","execution_count":54,"id":"n2_000025","metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"n2_000025","executionInfo":{"status":"ok","timestamp":1794109467263,"user_tz":-300,"elapsed":47,"user":{"displayName":"MUHAMMADNOUMAN FAZIL","userId":"00466758265510267650"}},"outputId":"4f71ef26-fa06-44db-a1e0-1ed99d80443a"},"outputs":[{"output_type":"stream","name":"stdout","text":["=========================================================================================================\n","                                 R2-N2 FINAL BUNDLE VERIFICATION REPORT                                  \n","=========================================================================================================\n","Verification Item                | Stage      | Status   | Evidence Detail                                 \n","---------------------------------------------------------------------------------------------------------\n","EchoProof Root Discovery         | Stage A    | PASS     | Root: /content/drive/.shortcut-targets-by-id/1icE6vOFhCIuhCe6gfhFE2JI2yGHGBbMR/PAI&AIES Project (verified pyproject.toml, src/, bundles/, locks/, tests/)\n","Original R2-M1 Artifacts         | Stage B    | PASS     | Found at runs/r2/r2_m1_20261106T140611Z/model, weights=3392B, Protocol B\n","Bundle Component Integrity       | Stage C    | PASS     | All 2 components match declared SHA-256 and byte sizes, 0 extra files, path safety verified, original-to-packaged match confirmed\n","Bundle Specification