                                     "test_command = [sys.executable, \"-B\", \"-m\", \"pytest\", \"tests/test_r2_wavlm_cache.py\", \"tests/test_r1_u1_wavlm.py\", \"-q\", \"-ra\", \"-p\", \"no:cacheprovider\"]\n",
