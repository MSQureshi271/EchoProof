    "from streamlit.testing.v1 import AppTest\n",
    "from echoproof.app_support import present\n",
    "\n",
    "# 1. Initialize Streamlit Application via AppTest\n",
    "app_file = str((ROOT / \"app/main.py\").resolve())\n",
    "at = AppTest.from_file(app_file, default_timeout=30)\n",
    "at.run()\n",
    "assert len(at.error) == 0, f\"App initialization error: {[e.value for e in at.error]}\"\n",
    "assert len(at.file_uploader) > 0, \"File uploader component not found\"\n",
    "\n",
    "# 2. Upload the Canonical Audio Bytes\n",
    "at.file_uploader[0].upload(\"verification_sample.wav\", CANONICAL_AUDIO_BYTES)\n",
    "at.run()\n",
    "assert len(at.error) == 0, f\"Error after file upload: {[e.value for e in at.error]}\"\n",
    "\n",
    "# 3. Click the 'Analyze' Button\n",
    "analyze_button = next((b for b in at.button if b.label == \"Analyze\"), None)\n",
    "assert analyze_button is not None, \"Analyze button missing from Streamlit app\"\n",
    "analyze_button.click().run()\n",
    "\n",
    "assert len(at.error) == 0, f\"Error during analysis execution: {[e.value for e in at.error]}\"\n",
    "assert \"analysis\" in at.session_state, \"Session state missing 'analysis' key\"\n",
    "\n",
    "# 4. Extract Application Analysis Results from Session State\n",
    "app_key, app_analysis = at.session_state[\"analysis\"]\n",
    "app_result = app_analysis.result\n",
    "app_score = app_result.score\n",
    "\n",
    "print(f\"[Streamlit Session State Output]\")\n",
    "print(f\"  Status             : {app_result.status}\")\n",
    "print(f\"  Assessment         : {app_result.assessment}\")\n",
    "print(f\"  Score              : {app_score:.12f}\")\n",
    "print(f\"  Model Version      : {app_result.model_version}\")\n",
    "print(f\"  Score Type         : {app_result.score_type}\")\n",
    "\n",
    "# 5. Inspect Rendered UI Elements Directly (Not Session State Alone)\n",
    "view = present(app_result)\n",
    "expected_headline = view[\"headline\"]\n",
    "expected_score_formatted = f\"{app_result.score:.3f}\"\n",
    "\n",
    "# Verify Success/Headline Banner\n",
    "rendered_success_values = [s.value for s in at.success]\n",
    "print(f\"\\n[Rendered UI Elements]\")\n",
    "print(f\"  Success Elements   : {rendered_success_values}\")\n",
    "assert len(at.success) > 0, \"No success indicator displayed in UI\"\n",
    "assert any(expected_headline in s for s in rendered_success_values), (\n",
    "    f\"Expected headline '{expected_headline}' not found in rendered success banners: {rendered_success_values}\"\n",
    ")\n",
    "\n",
    "# Verify Numerical Score is Rendered in Markdown Elements\n",
    "rendered_markdown_values = [m.value for m in at.markdown]\n",
