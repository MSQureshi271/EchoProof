    "import io\n",
    "from echoproof.inference import predict_recording, analyze\n",
    "from echoproof.data.chunks import eval_windows, PREPROCESSING_HASH, SAMPLE_RATE, WINDOW_SECONDS, STRIDE_SECONDS\n",
    "\n",
    "# 1. Deterministic Multi-Chunk Audio Generation\n",
    "# Using 6.0s duration at 16 kHz = 96,000 samples.\n",
    "# With window=64,000 (4s) and stride=32,000 (2s), this yields exactly 2 canonical evaluation windows:\n",
    "# Window 0: [0, 64000] (0.0s to 4.0s)\n",
    "# Window 1: [32000, 96000] (2.0s to 6.0s)\n",
    "DURATION_SEC = 6.0\n",
    "n_samples = int(round(DURATION_SEC * SAMPLE_RATE))\n",
    "t = np.arange(n_samples) / SAMPLE_RATE\n",
    "\n",
    "# Deterministic harmonic waveform exercising all 67 acoustic features (MFCCs, spectral, voicing)\n",
    "rng = np.random.default_rng(42)\n",
    "audio_signal = (\n",
    "    0.30 * np.sin(2 * np.pi * 220.0 * t) +\n",
    "    0.15 * np.sin(2 * np.pi * 440.0 * t) +\n",
    "    0.05 * np.sin(2 * np.pi * 880.0 * t) +\n",
    "    0.01 * rng.standard_normal(len(t))\n",
    ").astype(np.float32)\n",
    "\n",
    "buf = io.BytesIO()\n",
    "sf.write(buf, audio_signal, SAMPLE_RATE, format=\"WAV\", subtype=\"PCM_16\")\n",
    "CANONICAL_AUDIO_BYTES = buf.getvalue()\n",
    "\n",
    "expected_windows = eval_windows(n_samples)\n",
    "print(f\"[Audio Prepared] Generated canonical WAV recording:\")\n",
    "print(f\"  Duration           : {DURATION_SEC:.1f} s\")\n",
    "print(f\"  Sample Rate        : {SAMPLE_RATE} Hz (mono)\")\n",
    "print(f\"  Byte Size          : {len(CANONICAL_AUDIO_BYTES)} bytes\")\n",
    "print(f\"  Evaluation Windows : {expected_windows}\")\n",
    "print(f\"  Expected Chunks    : {len(expected_windows)}\")\n",
    "\n",
    "assert len(expected_windows) >= 2, f\"Audio duration {DURATION_SEC}s must produce >= 2 chunks, got {len(expected_windows)}\"\n",
    "\n",
    "# 2. Execute Shared Inference Pipeline\n",
    "analysis = analyze(CANONICAL_AUDIO_BYTES, bundle)\n",
    "result = analysis.result\n",
    "shared_score = result.score\n",
    "chunk_count = len(analysis.chunk_scores)\n",
    "\n",
    "print(f\"\\n[Shared Inference Output]\")\n",
    "print(f\"  Status             : {result.status}\")\n",
