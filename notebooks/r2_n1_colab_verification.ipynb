    "from echoproof.data.audio import decode_audio\n",
    "from echoproof.evaluation.aggregate import aggregate_recordings, aggregate_from_contracts\n",
    "from echoproof.contracts import Recording, SplitAssignment, Chunk, ChunkScore\n",
    "\n",
    "# 1. Decode Canonical Audio and Extract Evaluation Chunks\n",
    "wave = decode_audio(CANONICAL_AUDIO_BYTES)\n",
    "windows = eval_windows(len(wave.samples))\n",
    "chunk_waveforms = [wave.samples[a:b] for a, b in windows]\n",
    "\n",
    "# Assert multi-chunk condition\n",
    "assert len(chunk_waveforms) >= 2, f\"Evaluator test requires >= 2 chunks, found {len(chunk_waveforms)}\"\n",
    "print(f\"[Evaluator Input] {len(chunk_waveforms)} chunks extracted from {len(wave.samples) / wave.sample_rate:.1f}s audio.\")\n",
    "\n",
    "# 2. Score Chunks Using the Loaded LR-B Model Scorer\n",
    "chunk_probabilities = [float(s) for s in bundle.scorer(chunk_waveforms)]\n",
    "for idx, (win, sc) in enumerate(zip(windows, chunk_probabilities)):\n",
    "    print(f\"  Chunk {idx}: samples [{win[0]:>6}:{win[1]:>6}] -> P(TTS) = {sc:.8f}\")\n",
    "\n",
    "# 3. R1-N1 Evaluator Aggregation via aggregate_recordings()\n",
    "eval_rec_scores = aggregate_recordings(\n",
    "    chunk_ids=[f\"chunk:verif:{i}\" for i in range(len(chunk_waveforms))],\n",
    "    recording_ids=[\"rec:verif:001\"] * len(chunk_waveforms),\n",
    "    labels=[1] * len(chunk_waveforms),\n",
    "    chunk_scores=chunk_probabilities,\n",
    ")\n",
    "evaluator_score = eval_rec_scores.scores[0]\n",
    "print(f\"\\nEvaluator (aggregate_recordings) Score : {evaluator_score:.12f}\")\n",
    "print(f\"Shared Pipeline (predict_recording) Score: {shared_score:.12f}\")\n",
    "\n",
    "diff_eval_shared = abs(evaluator_score - shared_score)\n",
    "print(f\"Absolute Difference (|Evaluator - Shared|) : {diff_eval_shared:.2e}\")\n",
    "assert math.isclose(evaluator_score, shared_score, rel_tol=1e-9, abs_tol=1e-9), (\n",
    "    f\"Evaluator score {evaluator_score} deviates from shared score {shared_score}\"\n",
    ")\n",
    "print(\"[Parity Check] Evaluator aggregate_recordings matches shared inference score.\")\n",
    "\n",
    "# 4. Formal Contract Aggregation via aggregate_from_contracts()\n",
    "rec = Recording(\n",
    "    schema_version=1,\n",
    "    recording_id=\"rec:verif:001\",\n",
    "    original_path=\"verification.wav\",\n",
    "    dataset=\"echoproof_verification\",\n",
    "    dataset_revision=\"v1\",\n",
    "    label=1,\n",
    "    label_verified=True,\n",
    "    method=\"tts\",\n",
    "    method_verified=True,\n",
    "    generator_family=\"melo\",\n",
    "    generator_version=\"1\",\n",
    "    language=\"en\",\n",
    "    source_utterance_id=None,\n",
    "    source_speaker_id=None,\n",
    "    target_voice_id=None,\n",
    "    reference_id=None,\n",
    "    transcript_hash=None,\n",
    "    duration_seconds=len(wave.samples) / wave.sample_rate,\n",
    "    sample_rate=wave.sample_rate,\n",
    "    channels=1,\n",
    "    codec=\"pcm_s16le\",\n",
    "    sha256=hashlib.sha256(CANONICAL_AUDIO_BYTES).hexdigest(),\n",
    "    quality_flags=[],\n",
    "    retained=True,\n",
    "    exclusion_reason=None,\n",
    "    license_ref=None,\n",
    ")\n",
    "split = SplitAssignment(\n",
    "    schema_version=1,\n",
    "    protocol_id=\"protocol:B\",\n",
    "    recording_id=\"rec:verif:001\",\n",
    "    group_id=\"speaker:verif\",\n",
    "    partition=\"test\",\n",
    "    validation_role=None,\n",
    "    family_policy=\"unseen\",\n",
    "    split_version=\"1\",\n",
    "    split_hash=\"0\" * 64,\n",
    ")\n",
    "contract_chunks = [\n",
    "    Chunk(\n",
    "        schema_version=1,\n",
    "        chunk_id=f\"chunk:protocol:B:rec:verif:001:{start}\",\n",
    "        recording_id=\"rec:verif:001\",\n",
    "        group_id=\"speaker:verif\",\n",
    "        protocol_id=\"protocol:B\",\n",
    "        partition=\"test\",\n",
    "        start_sample=start,\n",
    "        end_sample=end,\n",
    "        sample_rate=wave.sample_rate,\n",
    "        start_seconds=start / wave.sample_rate,\n",
    "        end_seconds=end / wave.sample_rate,\n",
    "        valid_samples=end - start,\n",
    "        input_samples=4 * wave.sample_rate,\n",
    "        preprocessing_hash=PREPROCESSING_HASH,\n",
    "    )\n",
    "    for start, end in windows\n",
    "]\n",
    "contract_scores = [ChunkScore(chunk_id=c.chunk_id, tts_probability=s) for c, s in zip(contract_chunks, chunk_probabilities)]\n",
    "\n",
    "contract_eval = aggregate_from_contracts(\n",
    "    recordings=[rec],\n",
    "    chunks=contract_chunks,\n",
    "    scores=contract_scores,\n",
    "    assignments=[split],\n",
    "    protocol_id=\"protocol:B\",\n",
    ")\n",
    "contract_eval_score = contract_eval.scores[0]\n",
    "print(f\"Evaluator (aggregate_from_contracts) Score: {contract_eval_score:.12f}\")\n",
    "assert math.isclose(contract_eval_score, shared_score, rel_tol=1e-9, abs_tol=1e-9), (\n",
    "    f\"Contract evaluator score {contract_eval_score} deviates from shared score {shared_score}\"\n",
    ")\n",
    "\n",
    "STAGE_RESULTS[\"Stage E (Evaluator Aggregation Parity)\"] = {\n",
    "    \"status\": \"PASS\",\n",
    "    \"details\": f\"{len(chunk_waveforms)} chunks aggregated, score={evaluator_score:.6f}, parity diff={diff_eval_shared:.2e}\"\n",
    "}\n",
    "print(\"\\n[Stage E Verdict] Evaluator aggregation parity verified on multi-chunk audio: PASS\")\n"
   ]
