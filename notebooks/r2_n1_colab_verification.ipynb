    "import re\n",
    "\n",
    "TEST_SUITES = [\n",
    "    (\"R2-N1 End-to-End Integration\", \"test_r2_n1_integration.py\"),\n",
    "    (\"R1-N1 Evaluation Aggregation\", \"test_r1_eval_aggregate.py\"),\n",
    "    (\"R1-N1 Evaluation Metrics\", \"test_r1_eval_metrics.py\"),\n",
    "    (\"R1-N1 Evaluation Threshold\", \"test_r1_eval_threshold.py\"),\n",
    "    (\"R1-N1 Evaluation Calibration\", \"test_r1_eval_calibrate.py\"),\n",
    "    (\"R1-N1 Evaluation Bootstrap\", \"test_r1_eval_bootstrap.py\"),\n",
    "    (\"R1-N2 Inference Pipeline\", \"test_r1_n2_inference.py\"),\n",
    "    (\"R2 LR Detector\", \"test_r2_lr_detector.py\"),\n",
    "]\n",
    "\n",
    "suite_summary = []\n",
    "total_t0 = time.monotonic()\n",
    "\n",
    "print(\"=\" * 88)\n",
    "print(f\"{'REGRESSION TEST SUITE EXECUTION':^88}\")\n",
    "print(\"=\" * 88)\n",
    "\n",
    "for suite_name, pattern in TEST_SUITES:\n",
    "    t0 = time.monotonic()\n",
    "    cmd = [sys.executable, \"-m\", \"unittest\", \"discover\", \"-s\", str(ROOT / \"tests\"), \"-p\", pattern]\n",
    "    res = subprocess.run(cmd, cwd=ROOT, capture_output=True, text=True)\n",
    "    dt = time.monotonic() - t0\n",
    "    combined = res.stdout + res.stderr\n",
    "    \n",
    "    # Parse test counts and status from unittest output\n",
    "    # Example lines:\n",
    "    # \"Ran 18 tests in 34.270s\"\n",
    "    # \"OK\" or \"OK (skipped=1)\" or \"FAILED (failures=1, errors=1)\"\n",
    "    ran_match = re.search(r\"Ran (\\d+) tests?\", combined)\n",
    "    ran_count = int(ran_match.group(1)) if ran_match else 0\n",
    "    \n",
    "    ok_match = re.search(r\"\\n(OK|FAILED)\\s*(\\([^\\)]+\\))?\", combined)\n",
    "    status_tag = ok_match.group(1) if ok_match else (\"OK\" if res.returncode == 0 and ran_count > 0 else \"FAILED\")\n",
    "    detail_tag = ok_match.group(2) if ok_match and ok_match.group(2) else \"\"\n",
    "    \n",
    "    skipped_match = re.search(r\"skipped=(\\d+)\", combined)\n",
    "    skipped_count = int(skipped_match.group(1)) if skipped_match else 0\n",
    "    \n",
    "    failed_match = re.search(r\"failures=(\\d+)\", combined)\n",
    "    error_match = re.search(r\"errors=(\\d+)\", combined)\n",
    "    failed_count = (int(failed_match.group(1)) if failed_match else 0) + (int(error_match.group(1)) if error_match else 0)\n",
    "    passed_count = ran_count - skipped_count - failed_count if res.returncode == 0 else 0\n",
    "    \n",
    "    # Validation rules:\n",
    "    # 1. Never mark as PASS if 0 tests were discovered.\n",
    "    # 2. Never mark as PASS if returncode != 0 or FAILED in output.\n",
    "    if ran_count == 0:\n",
    "        suite_status = \"FAIL\"\n",
    "        err_excerpt = \"Zero tests discovered!\"\n",
    "    elif res.returncode == 0 and \"FAIL\" not in combined and \"ERROR\" not in combined:\n",
    "        suite_status = \"PASS\"\n",
    "        err_excerpt = \"\"\n",
    "    else:\n",
    "        suite_status = \"FAIL\"\n",
    "        err_excerpt = combined[-300:].strip()\n",
    "    \n",
    "    suite_summary.append({\n",
    "        \"suite\": suite_name,\n",
    "        \"pattern\": pattern,\n",
    "        \"command\": \" \".join(cmd),\n",
    "        \"status\": suite_status,\n",
    "        \"exit_code\": res.returncode,\n",
    "        \"total_run\": ran_count,\n",
    "        \"passed\": passed_count,\n",
    "        \"failed\": failed_count,\n",
    "        \"skipped\": skipped_count,\n",
    "        \"duration_s\": round(dt, 2),\n",
    "        \"details\": f\"Ran {ran_count} tests: {status_tag} {detail_tag}\".strip(),\n",
    "        \"error_excerpt\": err_excerpt,\n",
    "    })\n",
    "    \n",
    "    print(f\"[{suite_status:<4}] {suite_name:<30} ({dt:>5.2f}s) | Ran: {ran_count:>2} | Passed: {passed_count:>2} | Skipped: {skipped_count} | Failed: {failed_count}\")\n",
    "    if err_excerpt:\n",
    "        print(f\"       Error excerpt: {err_excerpt}\")\n",
    "\n",
    "total_elapsed = time.monotonic() - total_t0\n",
    "all_regressions_passed = all(s[\"status\"] == \"PASS\" for s in suite_summary)\n",
    "total_tests_run = sum(s[\"total_run\"] for s in suite_summary)\n",
    "total_tests_passed = sum(s[\"passed\"] for s in suite_summary)\n",
    "total_tests_skipped = sum(s[\"skipped\"] for s in suite_summary)\n",
    "\n",
    "print(\"-\" * 88)\n",
    "print(f\"Total Suites Executed    : {len(suite_summary)} / {len(TEST_SUITES)}\")\n",
    "print(f\"Total Test Cases Run     : {total_tests_run} (Passed: {total_tests_passed}, Skipped: {total_tests_skipped})\")\n",
    "print(f\"Overall Regression Status: {'ALL PASSED' if all_regressions_passed else 'FAILURES DETECTED'}\")\n",
    "print(f\"Total Elapsed Time       : {total_elapsed:.2f} seconds\")\n",
    "\n",
    "assert all_regressions_passed, \"One or more regression suites failed! Review logs above.\"\n",
    "\n",
    "STAGE_RESULTS[\"Stage I (Regression Test Suite)\"] = {\n",
    "    \"status\": \"PASS\" if all_regressions_passed else \"FAIL\",\n",
    "    \"details\": f\"{len(suite_summary)} suites passed, {total_tests_run} test cases run ({total_tests_passed} passed, {total_tests_skipped} skipped)\"\n",
    "}\n",
    "print(\"\\n[Stage I Verdict] All regression test suites executed and verified: PASS\")\n"
   ]
  },
